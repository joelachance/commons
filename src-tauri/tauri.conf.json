{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Commons",
  "version": "0.1.0",
  "identifier": "dev.commons.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Commons",
        "width": 520,
        "height": 900,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
